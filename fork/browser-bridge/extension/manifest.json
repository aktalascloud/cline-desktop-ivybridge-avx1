{
  "manifest_version": 3,
  "name": "Cline DeepSeek Session Bridge",
  "version": "1.0.1",
  "description": "Connect your existing DeepSeek browser session to your local Cline fork.",
  "key": "",
  "permissions": [
    "cookies",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*"
  ],
  "action": {
    "default_popup": "connect.html",
    "default_icon": {
      "16": "icons/disconnected-16.png",
      "32": "icons/disconnected-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/disconnected-16.png",
    "32": "icons/disconnected-32.png"
  }
}

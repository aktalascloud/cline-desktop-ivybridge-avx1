{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cline Desktop AVX1 RU",
	"version": "1.0.18",
	"identifier": "cloud.aktalas.cline.desktop.avx1.ru",
	"build": {
		"beforeDevCommand": "bun run build:runtime && bun run dev:web",
		"devUrl": "http://localhost:3125",
		"frontendDist": "../webview/out"
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMUI5QzJEOERGQzMyMDEKUldRQk12eU5MWndiYmpsazRZZ2k4ZUhsM0hObWtYSkZ1YzRrMEVQYkt1dFI1L01INzVvY1crWmcK",
			"endpoints": [
				"https://raw.githubusercontent.com/aktalascloud/cline-desktop-ivybridge-avx1/avx1/fork/updater/latest.json"
			]
		}
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Cline Desktop AVX1 RU",
				"width": 1500,
				"height": 980,
				"resizable": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"nsis"
		],
		"category": "DeveloperTool",
		"shortDescription": "Cline AI coding agent",
		"longDescription": "Cline is an AI coding agent. It reads your code, edits files, runs commands, and works through tasks with you in any project on your machine.",
		"homepage": "https://cline.bot",
		"externalBin": [
			"bin/cline-cli"
		],
		"resources": [
			"icons/app/*.png",
			"icons/app/macos/*.png",
			"bin/remote-helpers/*",
			"bin/desktop-backend/**/*",
			"licenses/**/*",
			"bin/defaults/freellm.json"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"deb": {
				"files": {
					"/usr/share/metainfo": "linux/metainfo/stable"
				}
			},
			"rpm": {
				"files": {
					"/usr/share/metainfo": "linux/metainfo/stable"
				}
			}
		},
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"dmg": {
				"background": "dmg/background.gen.tiff",
				"windowSize": {
					"width": 640,
					"height": 432
				},
				"appPosition": {
					"x": 140,
					"y": 200
				},
				"applicationFolderPosition": {
					"x": 500,
					"y": 200
				}
			}
		},
		"useLocalToolsDir": true,
		"createUpdaterArtifacts": true,
		"license": "Apache-2.0"
	}
}

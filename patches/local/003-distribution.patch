index 0000000000000000000000000000000000000000..0d03a7ec485eeaff7a1c1d0ce2b609c6648fe048
--- /dev/null
+++ b/fork/README.md
@@ -0,0 +1,25 @@
+# Build and maintenance
+
+Windows x64; PowerShell 7, Git, Bun 1.4.2 (x64 baseline), Node 24.20.0, Python 3.13.14, Rust 1.97.0, MSVC 14.44.35207, Windows SDK 10.0.26100.0. No fixed drive, user name, model, server or personal profile is required.
+
+1. Install pinned prerequisites. Use the MSVC developer shell, or let the bootstrap discover Visual Studio Build Tools.
+2. Check out the exact reviewed commit. Keep the existing updater key outside this repository.
+3. Run from the repository root:
+
+```powershell
+pwsh -File fork/bootstrap-windows.ps1 -SourceSha <40-character-SHA> -SigningKeyFile <private-key-file>
+```
+
+Output: `dist/avx1/Cline-Desktop-AVX1-RU-Setup.exe`, manifest and check receipts. Frozen lockfiles are mandatory. Reuse matching caches; relocation may invalidate native cache entries. Stop on failure, fix the first failed stage and continue. Never suppress errors or publish a repaired payload.
+
+Default profile: O3, Ivy Bridge, fat LTO, one codegen unit, AVX2/FMA disabled. No PGO/pinning. Bun/JSC, Python and system WebView2 are prebuilts. Other compiler profiles are measurement inputs, not release channels. [Measurements](performance.md).
+
+Updates: review upstream and relevant active forks, PRs/issues and complete applicable code. Import upstream through [sanitized history](history-policy.md). Keep licenses and tags. Run targeted tests, typechecks and production build; audit/sign; wait for idle; install; compare profile and payload; run installed protocol checks. GUI is optional. Then publish one release/EXE, update the fork feed, verify server digest/size/tag/feed and copy EXE to Desktop. No repeat EXE download. Delete rollback only after success.
+
+Keep only current receipts and necessary tools. Preserve personal data, keys and original history. Cloud catalogs are provider data, not build requirements. Context/sampling follow the endpoint and user preferences. Never embed private models, URLs or settings in recipes.
+
+Current decisions: `review-ledger.json`. Package: `components.json`, `qualification.json`. One daily Codex chat task at 08:00 Asia/Bishkek; no CI cron.
+
+[Current status, included fixes and remaining validation](STATUS.md). Documentation-only maintenance does not require a new installer.
+
+Applied fork changes are indexed in [patches](../patches/README.md). Their source overlays must replay exactly against the recorded sanitized base; builds run `python fork/local-patches.py --check`. A fork checkout already has these changes; do not apply them twice. The patch directory contains no unadopted research candidates.
diff --git a/fork/bench-history.ts b/fork/bench-history.ts
new file mode 100644
index 0000000000000000000000000000000000000000..42c377d2e266f1f824e8729bf9938df6c8a9178c
--- /dev/null
+++ b/fork/bench-history.ts
@@ -0,0 +1,130 @@
+/** Synthetic history discovery benchmark. No provider, network or agent turn. */
+import { mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { dlopen, FFIType, ptr } from "bun:ffi";
+
+const directory = process.env.AVX1_BENCH_DIR;
+if (!directory || process.platform !== "win32")
+	throw new Error("A private AVX1_BENCH_DIR on Windows is required");
+mkdirSync(directory, { recursive: true });
+process.env.CLINE_DIR = directory;
+process.env.CLINE_DATA_DIR = join(directory, "data");
+process.env.CLINE_NO_AUTO_UPDATE = "1";
+const { SqliteSessionStore } = await import(
+	Bun.resolveSync(
+		"@cline/core",
+		join(import.meta.dir, "../apps/examples/desktop-app/sidecar/session-data"),
+	)
+);
+const { discoverChatSessions } = await import(
+	"../apps/examples/desktop-app/sidecar/session-data/discovery"
+);
+const kernel = dlopen("kernel32.dll", {
+	GetCurrentProcessId: { args: [], returns: FFIType.u32 },
+	OpenProcess: {
+		args: [FFIType.u32, FFIType.bool, FFIType.u32],
+		returns: FFIType.ptr,
+	},
+	GetProcessHandleCount: {
+		args: [FFIType.ptr, FFIType.ptr],
+		returns: FFIType.bool,
+	},
+	CloseHandle: { args: [FFIType.ptr], returns: FFIType.bool },
+});
+const handle = kernel.symbols.OpenProcess(
+	0x1000,
+	false,
+	kernel.symbols.GetCurrentProcessId(),
+);
+if (!handle) throw new Error("Cannot query benchmark process handles");
+const handleCount = () => {
+	const value = new Uint32Array(1);
+	if (!kernel.symbols.GetProcessHandleCount(handle, ptr(value)))
+		throw new Error("Handle query failed");
+	return value[0];
+};
+const sessions = 250,
+	iterations = 100;
+const liveSessions = new Map();
+const store = new SqliteSessionStore();
+store.run("BEGIN");
+for (let i = 0; i < sessions; i++) {
+	const id = `fixture-${i}`;
+	store.create({
+		sessionId: id,
+		source: "desktop",
+		pid: 0,
+		startedAt: "2026-01-01T00:00:00.000Z",
+		status: "completed",
+		interactive: true,
+		provider: "fixture",
+		model: "fixture",
+		cwd: directory,
+		workspaceRoot: directory,
+		enableTools: true,
+		enableSpawn: false,
+		enableTeams: false,
+		isSubagent: false,
+		prompt: `Synthetic task ${i}`,
+	} as never);
+	liveSessions.set(id, {
+		busy: false,
+		prompt: `Synthetic task ${i}`,
+		messages: [],
+		status: "completed",
+		config: { provider: "fixture", model: "fixture", cwd: directory },
+		startedAt: 1,
+	});
+}
+store.run("COMMIT");
+store.close();
+const mode = process.argv.includes("--baseline")
+	? "upstream-close-omission"
+	: "closed-stores";
+const original = SqliteSessionStore.prototype.close;
+// Controlled counterfactual: every other source line and input stays identical.
+let skippedClosures = 0;
+if (mode === "upstream-close-omission")
+	SqliteSessionStore.prototype.close = () => {
+		skippedClosures++;
+	};
+try {
+	for (let i = 0; i < 3; i++) discoverChatSessions({ liveSessions });
+	let peakHandles = handleCount(),
+		peakRss = process.memoryUsage().rss;
+	const beforeHandles = peakHandles,
+		beforeRss = peakRss,
+		cpu = process.cpuUsage(),
+		start = performance.now();
+	for (let i = 0; i < iterations; i++) {
+		if (discoverChatSessions({ liveSessions }).length !== sessions)
+			throw new Error("Incorrect history result");
+		peakHandles = Math.max(peakHandles, handleCount());
+		peakRss = Math.max(peakRss, process.memoryUsage().rss);
+	}
+	const duration = performance.now() - start,
+		used = process.cpuUsage(cpu);
+	if (mode === "upstream-close-omission" && skippedClosures !== iterations + 3)
+		throw new Error("Counterfactual did not intercept every owned connection");
+	console.log(
+		JSON.stringify({
+			mode,
+			sessions,
+			iterations,
+			warmup: 3,
+			wall_ms: duration,
+			cpu_user_ms: used.user / 1000,
+			cpu_system_ms: used.system / 1000,
+			handles_before: beforeHandles,
+			handles_after: handleCount(),
+			handles_peak: peakHandles,
+			rss_before: beforeRss,
+			rss_peak: peakRss,
+			bun: Bun.version,
+		}),
+	);
+} finally {
+	SqliteSessionStore.prototype.close = original;
+	kernel.symbols.CloseHandle(handle);
+	kernel.close();
+}
diff --git a/fork/bootstrap-windows.ps1 b/fork/bootstrap-windows.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..c5d9d9444d3c881b80bd669105221530641cf7a9
--- /dev/null
+++ b/fork/bootstrap-windows.ps1
@@ -0,0 +1,27 @@
+param(
+ [string]$SourceSha,
+ [string]$SigningKeyFile,
+ [ValidateSet('minimal','full')][string]$Checks='minimal'
+)
+$ErrorActionPreference='Stop'
+$root=Split-Path -Parent $PSScriptRoot
+if(-not $SourceSha){$SourceSha=(git -C $root rev-parse HEAD).Trim()}
+if($SourceSha -notmatch '^[0-9a-f]{40}$'){throw 'Use a full source SHA'}
+if(git -C $root status --porcelain --untracked-files=no){throw 'Commit or restore tracked changes before building'}
+if(-not $env:VCToolsInstallDir){
+ $vswhere=Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio/Installer/vswhere.exe'
+ if(-not (Test-Path -LiteralPath $vswhere)){throw 'Install Visual Studio Build Tools with MSVC 14.44.35207 and Windows SDK 10.0.26100.0'}
+ $vs=& $vswhere -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath
+ if(-not $vs){throw 'MSVC Build Tools not found'}
+ Import-Module "$vs/Common7/Tools/Microsoft.VisualStudio.DevShell.dll"
+ Enter-VsDevShell -VsInstallPath $vs -SkipAutomaticLocation -DevCmdArguments '-arch=x64 -host_arch=x64 -vcvars_ver=14.44.35207 -winsdk=10.0.26100.0'
+}
+if($SigningKeyFile){
+ $env:TAURI_SIGNING_PRIVATE_KEY=(Get-Content -LiteralPath $SigningKeyFile -Raw).Trim()
+}
+if(-not $env:TAURI_SIGNING_PRIVATE_KEY){throw 'Supply the existing fork updater key with -SigningKeyFile or TAURI_SIGNING_PRIVATE_KEY'}
+try {
+ & "$PSScriptRoot/build-windows.ps1" -SourceSha $SourceSha -Profile ivy-fat1 -Checks $Checks
+} finally {
+ if($SigningKeyFile){Remove-Item Env:TAURI_SIGNING_PRIVATE_KEY -ErrorAction SilentlyContinue}
+}
diff --git a/fork/build-windows.ps1 b/fork/build-windows.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..3927b1d2a3d10c83dc81b4c4cb88a27998385074
--- /dev/null
+++ b/fork/build-windows.ps1
@@ -0,0 +1,107 @@
+param(
+  [Parameter(Mandatory)][ValidatePattern('^[0-9a-f]{40}$')][string]$SourceSha,
+  [ValidateSet('default','ivy-thin8','ivy-thin1','ivy-fat1')][string]$Profile='ivy-fat1',
+  [switch]$SkipPrepare,
+  [ValidateSet('minimal','full')][string]$Checks='minimal'
+)
+$ErrorActionPreference='Stop'
+$root=Split-Path -Parent $PSScriptRoot
+$app=Join-Path $root 'apps\examples\desktop-app'
+if(-not $env:CARGO_HOME){$env:CARGO_HOME=Join-Path $env:USERPROFILE '.cargo'}
+if(-not $env:BUN_INSTALL_CACHE_DIR){$env:BUN_INSTALL_CACHE_DIR=Join-Path $root '.build-cache\bun'}
+$env:PATH="$env:VCToolsInstallDir\bin\Hostx64\x64;${env:ProgramFiles}\Git\usr\bin;$env:PATH"
+Push-Location $root
+try {
+  if((git rev-parse HEAD).Trim() -ne $SourceSha){throw 'Checkout does not match the pinned source SHA'}
+  python (Join-Path $PSScriptRoot 'local-patches.py') --check
+  if($LASTEXITCODE){throw 'Active local patch inventory verification failed'}
+  $configuration=Get-Content "$app/src-tauri/tauri.conf.json" -Raw|ConvertFrom-Json
+  $package=Get-Content "$app/package.json" -Raw|ConvertFrom-Json
+  $changelogVersion=[regex]::Match((Get-Content "$app/CHANGELOG.md" -Raw),'(?m)^## ([^\r\n ]+)').Groups[1].Value
+  if($package.version -ne $configuration.version -or $package.version -ne $changelogVersion){throw 'Package, native and changelog versions must match before building'}
+  $baseline=(Get-Content "$PSScriptRoot/components.json" -Raw|ConvertFrom-Json).build_source_sha
+  $nativeChanges=@(git diff --name-only $baseline -- apps/examples/desktop-app/src-tauri/src apps/examples/desktop-app/src-tauri/Cargo.toml apps/examples/desktop-app/src-tauri/Cargo.lock apps/examples/desktop-app/src-tauri/build.rs rust-toolchain.toml)
+
+  if((bun --version).Trim() -ne '1.4.2'){throw 'Bun 1.4.2 is required'}
+  if((node --version).Trim() -ne 'v24.20.0'){throw 'Node 24.20.0 is required'}
+  if((python --version).Trim() -ne 'Python 3.13.14'){throw 'Python 3.13.14 is required'}
+  if((rustc --version) -notmatch '^rustc 1\.97\.0 '){throw 'Rust 1.97.0 is required'}
+  if(-not $env:VCToolsInstallDir -or $env:VCToolsInstallDir.TrimEnd('\') -notmatch '\\14\.44\.35207$'){throw 'MSVC toolset 14.44.35207 is required'}
+  if($env:WindowsSDKVersion.TrimEnd('\') -ne '10.0.26100.0'){throw 'Windows SDK 10.0.26100.0 is required'}
+  $env:CARGO_BUILD_JOBS='6'
+  $env:NEXT_TELEMETRY_DISABLED='1'
+  $env:CLINE_NO_AUTO_UPDATE='1'
+  # No telemetry credentials or private exporter addresses enter a public bundle.
+  foreach($key in @('TELEMETRY_SERVICE_API_KEY','ERROR_SERVICE_API_KEY','OTEL_EXPORTER_OTLP_ENDPOINT','OTEL_EXPORTER_OTLP_HEADERS','CLINE_CODE_CLOUD_AGENTS')){Remove-Item "Env:$key" -ErrorAction SilentlyContinue}
+  $env:OTEL_TELEMETRY_ENABLED='0'
+  $env:OTEL_LOGS_EXPORTER='none';$env:OTEL_METRICS_EXPORTER='none';$env:OTEL_TRACES_EXPORTER='none'
+  $env:CC_ENABLE_DEBUG_OUTPUT='1';$env:CLINE_TRACE_RECORD_CONTENT='0'
+  if(-not $SkipPrepare){
+    bun install --frozen-lockfile
+    if($LASTEXITCODE){throw 'Dependency installation failed'}
+    python (Join-Path $PSScriptRoot 'seed-bun.py')
+    if($LASTEXITCODE){throw 'Runtime verification failed'}
+    bun -F @cline/code build:runtime
+    if($LASTEXITCODE){throw 'CLI/Hub/backend build failed'}
+    python (Join-Path $PSScriptRoot 'prepare-defaults.py')
+    if($LASTEXITCODE){throw 'Bundled defaults preparation failed'}
+    & "$app/src-tauri/bin/defaults/python/python.exe" -I -B -X utf8 "$PSScriptRoot/test-defaults.py"
+    if($LASTEXITCODE){throw 'Bundled defaults protocol check failed'}
+    python ./fork/check-bundle-paths.py
+    if($LASTEXITCODE){throw 'Generated runtime privacy check failed'}
+    bun test fork/logging-bundle.test.ts
+    if($LASTEXITCODE){throw 'Relocatable logger worker tests failed'}
+    bun test fork/zod-bounds.test.ts
+    if($LASTEXITCODE){throw 'Schema resource-bound checks failed'}
+    & "$app\src-tauri\bin\cline-cli-x86_64-pc-windows-msvc.exe" --version
+    if($LASTEXITCODE){throw 'Compiled CLI execution failed'}
+    cargo fetch --locked --manifest-path "$app\src-tauri\Cargo.toml"
+    if($LASTEXITCODE){throw 'Cargo lock verification failed'}
+    python (Join-Path $PSScriptRoot 'collect-licenses.py')
+    if($LASTEXITCODE){throw 'License inventory failed'}
+    python (Join-Path $PSScriptRoot 'seed-nsis.py')
+    if($LASTEXITCODE){throw 'NSIS tool verification failed'}
+    $env:MAKENSIS_PATH=Join-Path $root '.build-cache\nsis\nsis-3.13\makensis.exe'
+    bun -F @cline/code test:windows-installer
+    if($LASTEXITCODE){throw 'Real Windows installer hook tests failed'}
+    & "$PSScriptRoot/validate-windows.ps1" -Mode $Checks -BaselineSha $baseline
+    bun -F @cline/code build:web
+    if($LASTEXITCODE){throw 'Production frontend build failed'}
+
+  }
+  $flagArgs=@("--remap-path-prefix=$root=/src/cline")
+  $env:RUSTFLAGS="--remap-path-prefix=$root=/src/cline"
+  if($env:CARGO_HOME){$env:RUSTFLAGS+=" --remap-path-prefix=$env:CARGO_HOME=/src/cargo";$flagArgs+="--remap-path-prefix=$env:CARGO_HOME=/src/cargo"}
+  $env:CARGO_PROFILE_RELEASE_OPT_LEVEL='3'
+  $env:CARGO_PROFILE_RELEASE_DEBUG='0'
+  if($Profile -eq 'default'){
+    $env:CARGO_PROFILE_RELEASE_LTO='false';$env:CARGO_PROFILE_RELEASE_CODEGEN_UNITS='16'
+  }else{
+    $env:RUSTFLAGS+=' -C target-cpu=ivybridge -C target-feature=-avx2,-fma'
+    $flagArgs+=@('-C','target-cpu=ivybridge','-C','target-feature=-avx2,-fma')
+    $env:CARGO_PROFILE_RELEASE_LTO=if($Profile -eq 'ivy-fat1'){'fat'}else{'thin'}
+    $env:CARGO_PROFILE_RELEASE_CODEGEN_UNITS=if($Profile -eq 'ivy-thin8'){'8'}else{'1'}
+  }
+  # Cargo's whitespace-separated RUSTFLAGS cannot preserve source paths with spaces.
+  $env:CARGO_ENCODED_RUSTFLAGS=$flagArgs -join [char]0x1f
+  Push-Location $app
+  try {
+    if($Checks -eq 'full' -or $nativeChanges.Count){
+      cargo test --locked --release --manifest-path src-tauri\Cargo.toml
+      if($LASTEXITCODE){throw 'Native tests failed'}
+    }
+    bun tauri build --bundles nsis --config src-tauri\tauri.prepared.conf.json --verbose -- --locked
+    if($LASTEXITCODE){throw 'Native installer build failed'}
+  }finally{Pop-Location}
+  $target=if($env:CARGO_TARGET_DIR){$env:CARGO_TARGET_DIR}else{"$app\src-tauri\target"}
+  $installers=@(Get-ChildItem "$target\release\bundle\nsis" -Filter ("Cline Desktop AVX1 RU_"+$configuration.version+"_x64-setup.exe"))
+  if($installers.Count -ne 1){throw 'Expected one NSIS installer'}
+  $output=Join-Path $root 'dist\avx1';New-Item -ItemType Directory -Path $output -Force|Out-Null
+  $exe=Join-Path $output 'Cline-Desktop-AVX1-RU-Setup.exe';Copy-Item -LiteralPath $installers[0].FullName -Destination $exe -Force
+  $publicKeyFile=Join-Path $PSScriptRoot 'updater\public-key.txt'
+  $configuredKey=(Get-Content "$app\src-tauri\tauri.conf.json" -Raw|ConvertFrom-Json).plugins.updater.pubkey
+  if((Get-Content -LiteralPath $publicKeyFile -Raw).Trim() -ne $configuredKey){throw 'Updater public-key copies differ'}
+  cargo run --locked --release --target-dir (Join-Path $root '.build-cache\updater-verifier') --manifest-path (Join-Path $PSScriptRoot 'verify-updater\Cargo.toml') -- $exe $publicKeyFile ($installers[0].FullName+'.sig')
+  if($LASTEXITCODE){throw 'Updater signature/tamper verification failed'}
+  [ordered]@{source_sha=$SourceSha;profile=$Profile;sha256=(Get-FileHash $exe -Algorithm SHA256).Hash.ToLowerInvariant();size=(Get-Item $exe).Length;rustflags=$env:RUSTFLAGS.Replace($root,'<source>').Replace($env:CARGO_HOME,'<cargo>');lto=$env:CARGO_PROFILE_RELEASE_LTO;codegen_units=$env:CARGO_PROFILE_RELEASE_CODEGEN_UNITS;hardware_qualification='required on Ivy Bridge before publication'} | ConvertTo-Json | Set-Content "$output\manifest.json" -Encoding utf8
+}finally{Pop-Location}
diff --git a/fork/check-bundle-paths.py b/fork/check-bundle-paths.py
new file mode 100644
index 0000000000000000000000000000000000000000..008be3dcec95fdd69f602cc58819bef19178502a
--- /dev/null
+++ b/fork/check-bundle-paths.py
@@ -0,0 +1,23 @@
+"""Fail before packaging if generated runtimes contain checkout paths or the signing secret."""
+import base64, os, pathlib, sys
+root=pathlib.Path(__file__).resolve().parents[1]
+patterns=[]
+for value in {str(root),str(root).replace('\\','/'),str(root).replace('\\','\\\\')}:
+    patterns += [('checkout path',value.encode()),('checkout path',value.encode('utf-16le'))]
+key=os.environ.get('TAURI_SIGNING_PRIVATE_KEY','').strip()
+if key:
+    patterns.append(('signing secret',key.encode()))
+    try:patterns.append(('decoded signing secret',base64.b64decode(key,validate=True)))
+    except ValueError:pass
+overlap=max(len(value) for _,value in patterns)
+count=0
+for path in (root/'apps/examples/desktop-app/src-tauri/bin').rglob('*'):
+    if not path.is_file():continue
+    count+=1;tail=b''
+    with path.open('rb') as stream:
+        while block:=stream.read(4*1024*1024):
+            data=tail+block
+            for kind,value in patterns:
+                if value and value in data:raise SystemExit(f'Bundle rejected: {kind} in {path.name}')
+            tail=data[-overlap:]
+print(f'Generated runtime privacy check passed ({count} files)')

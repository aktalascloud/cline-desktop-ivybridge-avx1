diff --git a/sdk/packages/ui/components/ui-locale.tsx b/sdk/packages/ui/components/ui-locale.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c1937af81b438bf26a11d9f1506824c536cd94c4
--- /dev/null
+++ b/sdk/packages/ui/components/ui-locale.tsx
@@ -0,0 +1,31 @@
+"use client";
+import { createContext, useContext, type ReactNode } from "react";
+export type UiTranslator = (
+	text: string,
+	parameters?: Readonly<Record<string, string | number>>,
+) => string;
+export const t: UiTranslator = (text, parameters) =>
+	parameters
+		? text.replace(/\{(\w+)\}/g, (token, name: string) =>
+				Object.hasOwn(parameters, name) ? String(parameters[name]) : token,
+			)
+		: text;
+const Context = createContext<{ t: UiTranslator; locale: string }>({
+	t,
+	locale: "en",
+});
+export function UiLocaleProvider({
+	value,
+	children,
+}: {
+	value: { t: UiTranslator; locale: string };
+	children: ReactNode;
+}) {
+	return <Context.Provider value={value}>{children}</Context.Provider>;
+}
+export function useUiLocale() {
+	return useContext(Context);
+}
+export function useTranslation() {
+	return useUiLocale().t;
+}

new file mode 100644
index 0000000000000000000000000000000000000000..d8caa753e5d93da7d4db990eb56cdc62a4d69511
--- /dev/null
+++ b/apps/examples/desktop-app/webview/components/views/chat/deepseek-controls.test.tsx
@@ -0,0 +1,90 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+const mocks = vi.hoisted(() => ({
+	invoke: vi.fn(),
+	catalog: vi.fn(),
+	invalidate: vi.fn(),
+}));
+vi.mock("@/lib/desktop-client", () => ({
+	desktopClient: { invoke: mocks.invoke },
+}));
+vi.mock("@/lib/provider-model-catalog", () => ({
+	fetchProviderCatalog: mocks.catalog,
+	invalidateProviderCatalogCache: mocks.invalidate,
+}));
+vi.mock("@/lib/i18n", () => ({ useTranslation: () => translate }));
+const translate = (value: string) => value;
+import { DeepSeekControls } from "./deepseek-controls";
+let element: HTMLDivElement, root: Root;
+beforeEach(() => {
+	element = document.createElement("div");
+	document.body.append(element);
+	root = createRoot(element);
+	mocks.catalog.mockResolvedValue({
+		providers: [
+			{ id: "dsw2api", configValues: { "sampling.search_enabled": true } },
+		],
+	});
+	mocks.invoke.mockResolvedValue({});
+});
+afterEach(async () => {
+	await act(async () => root.unmount());
+	element.remove();
+	vi.clearAllMocks();
+});
+it("loads persisted search and toggles it without changing thinking or credentials", async () => {
+	const change = vi.fn();
+	await act(async () =>
+		root.render(
+			<DeepSeekControls
+				thinking={true}
+				disabled={false}
+				onThinkingChange={change}
+			/>,
+		),
+	);
+	let buttons = element.querySelectorAll("button");
+	expect(buttons[0].getAttribute("aria-pressed")).toBe("true");
+	expect(buttons[1].getAttribute("aria-pressed")).toBe("true");
+	await act(async () => buttons[1].click());
+	expect(mocks.invoke).toHaveBeenCalledWith("save_provider_settings", {
+		provider: "dsw2api",
+		settings: { sampling: { search_enabled: false } },
+	});
+	expect(change).not.toHaveBeenCalled();
+	await act(async () => buttons[0].click());
+	expect(change).toHaveBeenCalledWith(false);
+});
+it("save failure preserves previous state and shows error", async () => {
+	mocks.invoke.mockRejectedValueOnce(Error("synthetic"));
+	await act(async () =>
+		root.render(
+			<DeepSeekControls
+				thinking={false}
+				disabled={false}
+				onThinkingChange={() => {}}
+			/>,
+		),
+	);
+	await act(async () => element.querySelectorAll("button")[1].click());
+	expect(
+		element.querySelectorAll("button")[1].getAttribute("aria-pressed"),
+	).toBe("true");
+	expect(element.querySelector("[role=alert]")).not.toBeNull();
+});
+it("locks both controls during an active run", async () => {
+	await act(async () =>
+		root.render(
+			<DeepSeekControls
+				thinking={false}
+				disabled={true}
+				onThinkingChange={() => {}}
+			/>,
+		),
+	);
+	expect(
+		[...element.querySelectorAll("button")].every((button) => button.disabled),
+	).toBe(true);
+});
diff --git a/apps/examples/desktop-app/webview/components/views/chat/deepseek-controls.tsx b/apps/examples/desktop-app/webview/components/views/chat/deepseek-controls.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c3a23e3a083d594096537560ec2f5f48061979ca
--- /dev/null
+++ b/apps/examples/desktop-app/webview/components/views/chat/deepseek-controls.tsx
@@ -0,0 +1,97 @@
+"use client";
+import { Brain, Globe } from "lucide-react";
+import { useEffect, useState } from "react";
+import { desktopClient } from "@/lib/desktop-client";
+import { useTranslation } from "@/lib/i18n";
+import {
+	fetchProviderCatalog,
+	invalidateProviderCatalogCache,
+} from "@/lib/provider-model-catalog";
+
+/** DeepSeek Web has two independent capabilities, not reasoning budgets. */
+export function DeepSeekControls({
+	thinking,
+	disabled,
+	onThinkingChange,
+}: {
+	thinking: boolean;
+	disabled: boolean;
+	onThinkingChange: (enabled: boolean) => void;
+}) {
+	const t = useTranslation();
+	const [search, setSearch] = useState(false);
+	const [saving, setSaving] = useState(false);
+	const [ready, setReady] = useState(false);
+	const [error, setError] = useState("");
+	useEffect(() => {
+		let active = true;
+		void fetchProviderCatalog({ fresh: true })
+			.then((catalog) => {
+				if (active) {
+					setSearch(
+						catalog.providers.find((p) => p.id === "dsw2api")?.configValues?.[
+							"sampling.search_enabled"
+						] === true,
+					);
+					setReady(true);
+				}
+			})
+			.catch(() => {
+				if (active) setError(t("Failed to load sampling settings"));
+			});
+		return () => {
+			active = false;
+		};
+	}, [t]);
+	async function toggleSearch() {
+		setSaving(true);
+		setError("");
+		try {
+			const value = !search;
+			await desktopClient.invoke("save_provider_settings", {
+				provider: "dsw2api",
+				settings: { sampling: { search_enabled: value } },
+			});
+			invalidateProviderCatalogCache();
+			setSearch(value);
+		} catch {
+			setError(t("Failed to save sampling settings"));
+		} finally {
+			setSaving(false);
+		}
+	}
+	const style = (active: boolean) =>
+		"inline-flex items-center gap-1 rounded-full border px-2 py-1 text-xs disabled:opacity-40 " +
+		(active
+			? "border-primary bg-primary/10 text-primary"
+			: "border-transparent text-muted-foreground hover:bg-surface-hover");
+	return (
+		<div className="flex flex-wrap items-center gap-1">
+			<button
+				type="button"
+				aria-pressed={thinking}
+				disabled={disabled}
+				onClick={() => onThinkingChange(!thinking)}
+				className={style(thinking)}
+			>
+				<Brain className="size-3" />
+				{t("Deep thinking")}
+			</button>
+			<button
+				type="button"
+				aria-pressed={search}
+				disabled={disabled || saving || !ready}
+				onClick={() => void toggleSearch()}
+				className={style(search)}
+			>
+				<Globe className="size-3" />
+				{t("Smart search")}
+			</button>
+			{error ? (
+				<span role="alert" className="text-xs text-destructive">
+					{error}
+				</span>
+			) : null}
+		</div>
+	);
+}

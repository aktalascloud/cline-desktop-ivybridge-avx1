+import {describe,expect,it,vi} from "vitest";
+import {Blob} from "node:buffer";
+
+const invoke=vi.hoisted(()=>vi.fn());
+vi.mock("./desktop-client",()=>({desktopClient:{invoke}}));
+vi.mock("./recorded-audio",()=>({normalizeRecordedAudio:async()=>new Uint8Array([82,73,70,70])}));
+import {transcribeRecordedAudio} from "./recorded-transcription";
+
+describe("recorded voice input",()=>{
+  it("sends the encoded recording once and returns plain transcript text",async()=>{
+    invoke.mockResolvedValueOnce({text:"Распознанный текст"});
+    const blob=new Blob([new Uint8Array([82,73,70,70])],{type:"audio/wav"});
+    expect(await transcribeRecordedAudio(blob as globalThis.Blob)).toBe("Распознанный текст");
+    expect(invoke).toHaveBeenCalledTimes(1);
+    expect(invoke).toHaveBeenCalledWith("transcribe_audio",{audioBase64:"UklGRg==",mediaType:"audio/wav"});
+    invoke.mockClear();
+  });
+  it("rejects empty recordings before a provider request",async()=>{
+    await expect(transcribeRecordedAudio(new Blob([]) as globalThis.Blob)).rejects.toThrow("empty");
+    expect(invoke).not.toHaveBeenCalled();
+  });
+  it("does not retry a failed transcription request",async()=>{
+    invoke.mockRejectedValueOnce(new Error("synthetic network failure"));
+    const blob=new Blob(["sample"],{type:"audio/webm"});
+    await expect(transcribeRecordedAudio(blob as globalThis.Blob)).rejects.toThrow("synthetic network failure");
+    expect(invoke).toHaveBeenCalledTimes(1);invoke.mockClear();
+  });
+});
diff --git a/apps/examples/desktop-app/webview/lib/recorded-transcription.ts b/apps/examples/desktop-app/webview/lib/recorded-transcription.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9c2777e5457f52c382aeefd303172d0caebdb441
--- /dev/null
+++ b/apps/examples/desktop-app/webview/lib/recorded-transcription.ts
@@ -0,0 +1,25 @@
+"use client";
+
+import { desktopClient } from "./desktop-client";
+import { MAX_RECORDED_AUDIO_BYTES } from "./voice-input-limits";
+import { normalizeRecordedAudio } from "./recorded-audio";
+
+/** Batch STT for local OpenAI-compatible servers; never logs audio or text. */
+export async function transcribeRecordedAudio(blob: Blob): Promise<string> {
+  if (!blob.size || blob.size > MAX_RECORDED_AUDIO_BYTES) {
+    throw new Error("Recorded audio is empty or exceeds the recording limit.");
+  }
+  const bytes = await normalizeRecordedAudio(blob);
+  const chunks: string[] = [];
+  for (let start = 0; start < bytes.length; start += 16384) {
+    chunks.push(String.fromCharCode(...bytes.subarray(start, start + 16384)));
+  }
+  const response = await desktopClient.invoke<{text?: unknown}>("transcribe_audio", {
+    audioBase64: btoa(chunks.join("")),
+    mediaType: "audio/wav",
+  });
+  if (typeof response?.text !== "string") {
+    throw new Error("Transcription provider returned no text.");
+  }
+  return response.text;
+}

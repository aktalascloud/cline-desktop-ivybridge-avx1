+++ b/apps/examples/desktop-app/webview/components/views/settings/compaction-settings.test.tsx
@@ -0,0 +1,45 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { it, expect, vi } from "vitest";
+import { CompactionSettings } from "./compaction-settings";
+const mocks = vi.hoisted(() => ({ invoke: vi.fn() }));
+vi.mock("@/lib/desktop-client", () => ({
+	desktopClient: { invoke: mocks.invoke },
+}));
+vi.mock("@/lib/i18n", () => ({ useTranslation: () => (s: string) => s }));
+it("loads all three knobs and saves them through the backend", async () => {
+	Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+	const prefs = {
+		enabled: true,
+		triggerTokens: 90000,
+		maxInputTokens: 120000,
+		preserveRecentMessages: 40,
+	};
+	mocks.invoke.mockImplementation(async () => prefs);
+	const div = document.createElement("div");
+	document.body.append(div);
+	const root = createRoot(div);
+	try {
+		await act(async () => root.render(<CompactionSettings />));
+		expect(
+			[...div.querySelectorAll('input[type="number"]')].map(
+				(e) => (e as HTMLInputElement).value,
+			),
+		).toEqual(["90000", "120000", "40"]);
+		await act(async () =>
+			div
+				.querySelector("form")!
+				.dispatchEvent(
+					new Event("submit", { bubbles: true, cancelable: true }),
+				),
+		);
+		expect(mocks.invoke).toHaveBeenCalledWith("set_compaction_settings", {
+			settings: prefs,
+		});
+		expect(div.textContent).toContain("Compaction settings saved");
+	} finally {
+		await act(() => root.unmount());
+		div.remove();
+	}
+});
diff --git a/apps/examples/desktop-app/webview/components/views/settings/compaction-settings.tsx b/apps/examples/desktop-app/webview/components/views/settings/compaction-settings.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c256352c4066515f612b510206322f83bc4b1640
--- /dev/null
+++ b/apps/examples/desktop-app/webview/components/views/settings/compaction-settings.tsx
@@ -0,0 +1,140 @@
+"use client";
+import { useEffect, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Switch } from "@cline/ui";
+import { desktopClient } from "@/lib/desktop-client";
+import { useTranslation } from "@/lib/i18n";
+
+type Preferences = {
+	enabled: boolean;
+	triggerTokens: number;
+	maxInputTokens: number;
+	preserveRecentMessages: number;
+};
+export function CompactionSettings() {
+	const t = useTranslation();
+	const [value, setValue] = useState<Preferences>({
+		enabled: true,
+		triggerTokens: 90000,
+		maxInputTokens: 120000,
+		preserveRecentMessages: 40,
+	});
+	const [loading, setLoading] = useState(true);
+	const [saving, setSaving] = useState(false);
+	const [message, setMessage] = useState("");
+	useEffect(() => {
+		let active = true;
+		void desktopClient
+			.invoke<Preferences>("get_compaction_settings")
+			.then((v) => {
+				if (active && v) setValue(v);
+			})
+			.catch(() => {
+				if (active) setMessage("Could not load compaction settings");
+			})
+			.finally(() => {
+				if (active) setLoading(false);
+			});
+		return () => {
+			active = false;
+		};
+	}, []);
+	const save = async () => {
+		setSaving(true);
+		setMessage("");
+		try {
+			const saved = await desktopClient.invoke<Preferences>(
+				"set_compaction_settings",
+				{ settings: value },
+			);
+			if (saved) setValue(saved);
+			setMessage("Compaction settings saved");
+		} catch (e) {
+			setMessage(e instanceof Error ? e.message : String(e));
+		} finally {
+			setSaving(false);
+		}
+	};
+	const fields = [
+		{
+			key: "triggerTokens" as const,
+			label: "Token threshold",
+			min: 1024,
+			max: 10000000,
+			help: "Older context is summarized when the request reaches this threshold.",
+		},
+		{
+			key: "maxInputTokens" as const,
+			label: "Token limit",
+			min: 2048,
+			max: 10000000,
+			help: "The model window and answer reserve can lower the effective limit.",
+		},
+		{
+			key: "preserveRecentMessages" as const,
+			label: "Recent messages to preserve",
+			min: 0,
+			max: 1000,
+			help: "Keep recent messages and whole tool chains when they fit the budget. Full history stays saved.",
+		},
+	];
+	return (
+		<section
+			className="border-b py-4 space-y-4"
+			aria-label={t("Context compaction")}
+		>
+			<div className="flex items-center justify-between gap-4">
+				<h2 className="text-base font-semibold">
+					{t("Automatic context compaction")}
+				</h2>
+				<Switch
+					aria-label={t("Automatic context compaction")}
+					disabled={loading}
+					checked={value.enabled}
+					onCheckedChange={(enabled) => setValue({ ...value, enabled })}
+				/>
+			</div>
+			<form
+				className="space-y-3"
+				onSubmit={(e) => {
+					e.preventDefault();
+					void save();
+				}}
+			>
+				{fields.map((field) => (
+					<div key={field.key} className="max-w-xl space-y-1">
+						<label
+							htmlFor={`compaction-${field.key}`}
+							className="text-sm font-medium"
+						>
+							{t(field.label)}
+						</label>
+						<Input
+							id={`compaction-${field.key}`}
+							type="number"
+							min={field.min}
+							max={field.max}
+							step={1}
+							disabled={loading}
+							required
+							value={Number.isFinite(value[field.key]) ? value[field.key] : ""}
+							onChange={(e) =>
+								setValue({ ...value, [field.key]: e.target.valueAsNumber })
+							}
+						/>
+						<p className="text-xs text-muted-foreground">{t(field.help)}</p>
+					</div>
+				))}
+				<Button type="submit" disabled={saving || loading}>
+					{t(saving ? "Saving…" : "Save")}
+				</Button>
+				{message && (
+					<p role="status" className="text-sm">
+						{t(message)}
+					</p>
+				)}
+			</form>
+		</section>
+	);
+}

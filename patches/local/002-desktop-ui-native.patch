new file mode 100644
index 0000000000000000000000000000000000000000..9d1331c2bcf784847594e51313b4c5e845edf9ec
--- /dev/null
+++ b/apps/examples/desktop-app/webview/components/views/chat/messages/request-metrics.test.ts
@@ -0,0 +1,32 @@
+import { expect, it } from "vitest";
+import { formatRequestMetrics } from "./request-metrics";
+
+it("uses matching per-request counts and time without inventing missing counters", () => {
+	const t = (text: string) => text;
+	expect(
+		formatRequestMetrics(
+			{
+				outputTokens: 120,
+				requestDurationMs: 6000,
+				inputTokens: 1000,
+				cacheReadTokens: 750,
+			},
+			t,
+		),
+	).toBe("20.0 tok/s · cache 75%");
+	expect(formatRequestMetrics(undefined, t)).toBe("");
+	expect(
+		formatRequestMetrics({ outputTokens: 120, cacheReadTokens: 0 }, t),
+	).toBe("");
+	expect(
+		formatRequestMetrics(
+			{
+				inputTokens: 10,
+				cacheReadTokens: 20,
+				requestDurationMs: Number.NaN,
+				outputTokens: 3,
+			},
+			t,
+		),
+	).toBe("");
+});
diff --git a/apps/examples/desktop-app/webview/components/views/chat/messages/request-metrics.ts b/apps/examples/desktop-app/webview/components/views/chat/messages/request-metrics.ts
new file mode 100644
index 0000000000000000000000000000000000000000..043fda4989e26532ce597549a3b903993962b2cd
--- /dev/null
+++ b/apps/examples/desktop-app/webview/components/views/chat/messages/request-metrics.ts
@@ -0,0 +1,24 @@
+import type { ChatMessage } from "@/lib/chat-schema";
+
+export function formatRequestMetrics(
+	metrics: ChatMessage["meta"],
+	t: (text: string) => string,
+): string {
+	const finite = (value: unknown): value is number =>
+		typeof value === "number" && Number.isFinite(value) && value > 0;
+	const parts: string[] = [];
+	if (finite(metrics?.outputTokens) && finite(metrics?.requestDurationMs))
+		parts.push(
+			`${((metrics.outputTokens * 1000) / metrics.requestDurationMs).toFixed(1)} ${t("tok/s")}`,
+		);
+	// Older provider adapters normalize missing cache counters to zero; zero cannot prove cache reporting.
+	if (
+		finite(metrics?.inputTokens) &&
+		finite(metrics?.cacheReadTokens) &&
+		metrics.cacheReadTokens <= metrics.inputTokens
+	)
+		parts.push(
+			`${t("cache")} ${Math.round((metrics.cacheReadTokens * 100) / metrics.inputTokens)}%`,
+		);
+	return parts.join(" · ");
+}

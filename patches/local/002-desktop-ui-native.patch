+it("refreshes an open chat's model window without changing its route or credentials", () => {
+	read.mockReturnValue({
+		client: "openai-compatible",
+		protocol: "openai-chat",
+		baseUrl: "http://localhost:7777/v1",
+	});
+	registry.window = 131072;
+	const original = {
+		provider: "local-test",
+		model: "other-model",
+		providerConfig: {
+			apiKey: "synthetic-private",
+			baseUrl: "http://localhost:7777/v1",
+		},
+	};
+	const before = refreshLocalSamplingConfig(original);
+	registry.window = 256000;
+	const after = refreshLocalSamplingConfig(before);
+	expect((before.providerConfig as any).modelInfo.contextWindow).toBe(131072);
+	expect((after.providerConfig as any).modelInfo.contextWindow).toBe(256000);
+	expect(after.providerConfig).toMatchObject({
+		apiKey: "synthetic-private",
+		baseUrl: "http://localhost:7777/v1",
+	});
+	const historical = refreshLocalSamplingConfig({
+		...original,
+		baseUrl: "http://localhost:8888/v1",
+	});
+	expect((historical.providerConfig as any).modelInfo).toBeUndefined();
+});
diff --git a/apps/examples/desktop-app/sidecar/sampling-settings.ts b/apps/examples/desktop-app/sidecar/sampling-settings.ts
new file mode 100644
index 0000000000000000000000000000000000000000..88e457f14fce74ce586924228723d8a0df5ea15f
--- /dev/null
+++ b/apps/examples/desktop-app/sidecar/sampling-settings.ts
@@ -0,0 +1,78 @@
+import {
+	ProviderSettingsManager,
+	toProviderConfig,
+	readModelsFileSync,
+	resolveModelsRegistryPath,
+} from "@cline/core";
+import type { JsonRecord } from "./types";
+import { isQwen38NextAuthorModel } from "@cline/shared";
+
+/** Refresh local defaults and limits; preserve credentials and historical routes. */
+export function refreshLocalSamplingConfig(config: JsonRecord): JsonRecord {
+	const id = String(config.provider ?? config.providerId ?? "").trim();
+	if (!id) return config;
+	const settings = new ProviderSettingsManager().getProviderSettings(id);
+	if (
+		settings?.client !== "openai-compatible" ||
+		settings.protocol !== "openai-chat"
+	)
+		return config;
+	const modelId = String(
+		config.model ?? config.modelId ?? settings.model ?? "",
+	);
+	const models =
+		readModelsFileSync(resolveModelsRegistryPath(new ProviderSettingsManager()))
+			.providers[id]?.models ?? {};
+	const model = Object.entries(models).find(
+		([key, value]) => (value.id?.trim() || key.trim()) === modelId,
+	)?.[1];
+	if (
+		config.thinking !== false &&
+		["ultra", "adaptive"].includes(String(config.reasoningEffort))
+	) {
+		if (
+			model?.supportsAuthorModes !== true ||
+			!isQwen38NextAuthorModel(modelId)
+		)
+			throw new Error("Author reasoning modes are not enabled for this model.");
+	}
+	const existing =
+		config.providerConfig && typeof config.providerConfig === "object"
+			? (config.providerConfig as JsonRecord)
+			: {};
+	const historicalUrl = String(
+		config.baseUrl ?? existing.baseUrl ?? "",
+	).replace(/\/$/, "");
+	const sameEndpoint =
+		!historicalUrl ||
+		!settings.baseUrl ||
+		historicalUrl === settings.baseUrl.replace(/\/$/, "");
+	const modelInfo =
+		sameEndpoint &&
+		model &&
+		((model.contextWindow ?? 0) > 0 || (model.maxInputTokens ?? 0) > 0)
+			? { ...model, id: modelId }
+			: undefined;
+	return {
+		...config,
+		providerConfig: {
+			...toProviderConfig(
+				{
+					...settings,
+					model: String(config.model ?? config.modelId ?? settings.model ?? ""),
+				},
+				{ includeKnownModels: false },
+			),
+			...existing,
+			providerId: id,
+			...(modelInfo ? { modelInfo } : {}),
+			sampling: settings.sampling ?? {},
+			authorReasoningMode:
+				config.thinking !== false &&
+				(config.reasoningEffort === "ultra" ||
+					config.reasoningEffort === "adaptive")
+					? config.reasoningEffort
+					: undefined,
+		},
+	};
+}

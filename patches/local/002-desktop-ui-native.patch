+import { expect, it } from "vitest";
+import { modelReasoningChoices } from "./reasoning-choices";
+it("retains unknown local choices and respects a server toggle or always-on effort list", () => {
+	expect(modelReasoningChoices(undefined)).toBeUndefined();
+	expect(modelReasoningChoices([{ type: "toggle" }])).toEqual(["none", "high"]);
+	expect(
+		modelReasoningChoices([
+			{ type: "effort", values: ["low", "medium", "high", "xhigh"] },
+		]),
+	).toEqual(["low", "medium", "high", "xhigh"]);
+});
diff --git a/apps/examples/desktop-app/webview/lib/reasoning-choices.ts b/apps/examples/desktop-app/webview/lib/reasoning-choices.ts
new file mode 100644
index 0000000000000000000000000000000000000000..565e257cfc2dca34dc2d484aeda87631e0422c51
--- /dev/null
+++ b/apps/examples/desktop-app/webview/lib/reasoning-choices.ts
@@ -0,0 +1,18 @@
+import type { ProviderModel } from "./provider-schema";
+
+export function modelReasoningChoices(
+	options: ProviderModel["reasoningOptions"],
+): string[] | undefined {
+	if (!options?.length) return undefined;
+	const choices = options.flatMap((option) =>
+		option.type === "toggle"
+			? ["none", "high"]
+			: option.type === "effort"
+				? option.values.filter(
+						(value): value is Exclude<typeof value, null> =>
+							typeof value === "string" && value !== "default",
+					)
+				: [],
+	);
+	return choices.length ? [...new Set(choices)] : undefined;
+}

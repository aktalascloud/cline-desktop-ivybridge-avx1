+import { describe, expect, it } from "vitest";
+import type { SidecarContext } from "./types";
+import { getUpdateSafety } from "./update-safety";
+const context = (list: () => Promise<unknown[]>) =>
+	({
+		liveSessions: new Map(),
+		runtimeBindings: new Map([["local", { sessionManager: { list } }]]),
+	}) as unknown as SidecarContext;
+describe("fork update safety", () => {
+	it("allows idle Hubs", async () =>
+		expect(
+			await getUpdateSafety(
+				context(async () => [{ status: "completed" }, { status: "idle" }]),
+			),
+		).toEqual({ safe: true, activeSessionCount: 0 }));
+	it("blocks work started in another CLI", async () =>
+		expect(
+			(await getUpdateSafety(context(async () => [{ status: "running" }])))
+				.safe,
+		).toBe(false));
+	it("blocks queued prompts", async () => {
+		const ctx = context(async () => []);
+		ctx.liveSessions.set("x", {
+			status: "idle",
+			busy: false,
+			promptsInQueue: [{}],
+		} as never);
+		expect((await getUpdateSafety(ctx)).safe).toBe(false);
+	});
+	it("blocks disconnected or unknown Hub state", async () => {
+		expect(
+			(
+				await getUpdateSafety(
+					context(async () => {
+						throw new Error("offline");
+					}),
+				)
+			).safe,
+		).toBe(false);
+		expect(
+			(
+				await getUpdateSafety(
+					context(async () => [{ status: "new-unknown-state" }]),
+				)
+			).safe,
+		).toBe(false);
+	});
+	it("blocks an uninitialized backend", async () =>
+		expect(
+			(
+				await getUpdateSafety({
+					runtimeBindings: new Map(),
+					liveSessions: new Map(),
+				} as never)
+			).safe,
+		).toBe(false));
+});
diff --git a/apps/examples/desktop-app/sidecar/update-safety.ts b/apps/examples/desktop-app/sidecar/update-safety.ts
new file mode 100644
index 0000000000000000000000000000000000000000..338b383fb088d2e7ea4c676f990959fdd3f13567
--- /dev/null
+++ b/apps/examples/desktop-app/sidecar/update-safety.ts
@@ -0,0 +1,42 @@
+import type { SidecarContext } from "./types";
+
+const IDLE_OR_FINISHED = new Set([
+	"idle",
+	"completed",
+	"failed",
+	"stopped",
+	"cancelled",
+	"canceled",
+	"aborted",
+	"interrupted",
+	"expired",
+]);
+/** On-demand check of every connected Hub, including sessions started by CLI. */
+export async function getUpdateSafety(
+	ctx: SidecarContext,
+): Promise<{ safe: boolean; activeSessionCount: number }> {
+	if (!ctx.runtimeBindings?.size) return { safe: false, activeSessionCount: 0 };
+	let activeSessionCount = 0;
+	for (const session of ctx.liveSessions.values()) {
+		if (
+			session.busy ||
+			session.promptsInQueue.length > 0 ||
+			!IDLE_OR_FINISHED.has(session.status)
+		)
+			activeSessionCount++;
+	}
+	try {
+		for (const binding of ctx.runtimeBindings.values()) {
+			const rows = await binding.sessionManager.list(10_000, {
+				hydrate: false,
+			});
+			if (rows.length >= 10_000) return { safe: false, activeSessionCount };
+			for (const row of rows) {
+				if (!IDLE_OR_FINISHED.has(row.status)) activeSessionCount++;
+			}
+		}
+		return { safe: activeSessionCount === 0, activeSessionCount };
+	} catch {
+		return { safe: false, activeSessionCount };
+	}
+}

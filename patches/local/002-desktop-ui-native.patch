+++ b/apps/examples/desktop-app/webview/components/views/chat/sampling-settings.test.tsx
@@ -0,0 +1,126 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+	invoke: vi.fn(),
+	catalog: vi.fn(),
+	invalidate: vi.fn(),
+}));
+vi.mock("@/lib/desktop-client", () => ({
+	desktopClient: { invoke: mocks.invoke },
+}));
+vi.mock("@/lib/provider-model-catalog", () => ({
+	fetchProviderCatalog: mocks.catalog,
+	invalidateProviderCatalogCache: mocks.invalidate,
+}));
+import { SamplingSettings, samplingPatch } from "./sampling-settings";
+let container: HTMLDivElement;
+let root: Root;
+beforeEach(() => {
+	container = document.createElement("div");
+	document.body.appendChild(container);
+	root = createRoot(container);
+});
+afterEach(async () => {
+	await act(async () => root.unmount());
+	container.remove();
+	vi.resetAllMocks();
+});
+const button = (name: string) =>
+	Array.from(document.querySelectorAll("button")).find(
+		(b) => b.getAttribute("aria-label") === name || b.textContent === name,
+	)!;
+
+describe("sampling controls", () => {
+	it("preserves zero, clears overrides and excludes unchanged fields", () => {
+		expect(
+			samplingPatch(
+				{ temperature: "0", seed: "0", top_p: "", top_k: "20" },
+				{ temperature: "1", top_p: "0.95", top_k: "20" },
+			),
+		).toEqual({ temperature: 0, top_p: null });
+	});
+	it.each([
+		["temperature", "-1"],
+		["temperature", "3"],
+		["top_p", "1.1"],
+		["top_k", "1.5"],
+		["top_k", "65"],
+		["min_p", "-0.1"],
+	])("rejects invalid %s=%s", (key, value) => {
+		expect(() => samplingPatch({ [key]: value }, {})).toThrow();
+	});
+	it("ignores all removed fields in an old draft", () => {
+		expect(samplingPatch({ max_tokens: "1", presence_penalty: "1", repetition_penalty: "2", seed: "7", reasoning_budget_tokens: "16" }, {})).toEqual({});
+	});
+	it("loads only on open and saves a provider-local patch without credentials", async () => {
+		mocks.catalog.mockResolvedValue({
+			providers: [
+				{
+					id: "local-test",
+					configFields: [{ path: "sampling.temperature" }],
+					configValues: { "sampling.temperature": 1 },
+				},
+			],
+		});
+		mocks.invoke.mockResolvedValue({});
+		await act(async () =>
+			root.render(<SamplingSettings provider="local-test" />),
+		);
+		expect(mocks.catalog).not.toHaveBeenCalled();
+		await act(async () => button("Sampling settings").click());
+		const input = document.querySelector(
+			'input[aria-label="Temperature"]',
+		) as HTMLInputElement;
+		expect(input).not.toBeNull();
+		await act(async () => {
+			Object.getOwnPropertyDescriptor(
+				HTMLInputElement.prototype,
+				"value",
+			)!.set!.call(input, "0.7");
+			input.dispatchEvent(new Event("input", { bubbles: true }));
+		});
+		await act(async () => button("Save").click());
+		expect(mocks.invoke).toHaveBeenCalledWith("save_provider_settings", {
+			provider: "local-test",
+			settings: { sampling: { temperature: 0.7 } },
+		});
+		expect(mocks.invalidate).toHaveBeenCalledOnce();
+	});
+	it("does not offer unsupported provider controls", async () => {
+		mocks.catalog.mockResolvedValue({
+			providers: [{ id: "speech", configFields: [] }],
+		});
+		await act(async () => root.render(<SamplingSettings provider="speech" />));
+		await act(async () => button("Sampling settings").click());
+		expect(document.body.textContent).toContain(
+			"Sampling requires an OpenAI-compatible Chat provider",
+		);
+		expect(document.querySelector("input[type=number]")).toBeNull();
+		expect(mocks.invoke).not.toHaveBeenCalled();
+	});
+});
+
+it("sampling controls do not persist a hidden author mode", async () => {
+	mocks.catalog.mockResolvedValue({
+		providers: [
+			{
+				id: "local-test",
+				configFields: [{ path: "sampling.temperature" }],
+				configValues: { authorReasoningMode: "ultra" },
+			},
+		],
+	});
+	mocks.invoke.mockResolvedValue({});
+	await act(async () =>
+		root.render(<SamplingSettings provider="local-test" />),
+	);
+	await act(async () => button("Sampling settings").click());
+	expect(
+		document.querySelector('select[aria-label="Author reasoning mode"]'),
+	).toBeNull();
+	await act(async () => button("Save").click());
+	expect(mocks.invoke).not.toHaveBeenCalled();
+});
diff --git a/apps/examples/desktop-app/webview/components/views/chat/sampling-settings.tsx b/apps/examples/desktop-app/webview/components/views/chat/sampling-settings.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d283695569dfe1761c5178e6ba1c1953ef576686
--- /dev/null
+++ b/apps/examples/desktop-app/webview/components/views/chat/sampling-settings.tsx
@@ -0,0 +1,193 @@
+"use client";
+
+import { SlidersHorizontal } from "lucide-react";
+import { useEffect, useState } from "react";
+import {
+	Popover,
+	PopoverContent,
+	PopoverTrigger,
+} from "@/components/ui/popover";
+import { desktopClient } from "@/lib/desktop-client";
+import { useTranslation } from "@/lib/i18n";
+import {
+	fetchProviderCatalog,
+	invalidateProviderCatalogCache,
+} from "@/lib/provider-model-catalog";
+
+export const SAMPLING_FIELDS = [
+	{ key: "temperature", label: "Temperature", min: 0, max: 2, step: 0.05 },
+	{ key: "top_p", label: "Top-p", min: 0, max: 1, step: 0.01 },
+	{ key: "top_k", label: "Top-k", min: 1, max: 64, step: 1 },
+	{ key: "min_p", label: "Min-p", min: 0, max: 1, step: 0.01 },
+] as const;
+
+export function samplingPatch(
+	draft: Record<string, string>,
+	initial: Record<string, string>,
+) {
+	const patch: Record<string, number | null> = {};
+	for (const field of SAMPLING_FIELDS) {
+		const raw = (draft[field.key] ?? "").trim();
+		if (raw === (initial[field.key] ?? "").trim()) continue;
+		if (!raw) {
+			patch[field.key] = null;
+			continue;
+		}
+		const value = Number(raw);
+		if (
+			!Number.isFinite(value) ||
+			value < field.min ||
+			value > field.max ||
+			(field.step === 1 && !Number.isInteger(value))
+		)
+			throw new Error(`Invalid value: ${field.label}`);
+		patch[field.key] = value;
+	}
+	return patch;
+}
+
+/** Provider-local defaults. No global server updates and no generation requests. */
+export function SamplingSettings({
+	provider,
+	disabled,
+}: {
+	provider: string;
+	disabled?: boolean;
+}) {
+	const t = useTranslation();
+	const [open, setOpen] = useState(false);
+	const [initial, setInitial] = useState<Record<string, string>>({});
+	const [draft, setDraft] = useState<Record<string, string>>({});
+	const [loading, setLoading] = useState(false);
+	const [saving, setSaving] = useState(false);
+	const [error, setError] = useState("");
+	const [supported, setSupported] = useState(false);
+	useEffect(() => {
+		setOpen(false);
+	}, [provider]);
+	useEffect(() => {
+		if (!open) return;
+		let active = true;
+		setLoading(true);
+		setError("");
+		setSupported(false);
+		void fetchProviderCatalog({ fresh: true })
+			.then((catalog) => {
+				if (!active) return;
+				const entry = catalog.providers.find((p) => p.id === provider);
+				const available =
+					entry?.configFields?.some(
+						(f) => f.path === "sampling.temperature",
+					) === true;
+				setSupported(available);
+				const values = Object.fromEntries(
+					SAMPLING_FIELDS.map((f) => [
+						f.key,
+						String(entry?.configValues?.[`sampling.${f.key}`] ?? ""),
+					]),
+				);
+				setInitial(values);
+				setDraft(values);
+			})
+			.catch(() => {
+				if (active) setError(t("Failed to load sampling settings"));
+			})
+			.finally(() => {
+				if (active) setLoading(false);
+			});
+		return () => {
+			active = false;
+		};
+	}, [open, provider, t]);
+	async function save() {
+		setError("");
+		setSaving(true);
+		try {
+			const sampling = samplingPatch(draft, initial);
+			if (Object.keys(sampling).length) {
+				await desktopClient.invoke("save_provider_settings", {
+					provider,
+					settings: { sampling },
+				});
+				invalidateProviderCatalogCache();
+			}
+			setOpen(false);
+		} catch (e) {
+			setError(
+				e instanceof Error ? e.message : t("Failed to save sampling settings"),
+			);
+		} finally {
+			setSaving(false);
+		}
+	}
+	return (
+		<Popover
+			open={open}
+			onOpenChange={(value) => {
+				if (!saving) setOpen(value);
+			}}
+		>
+			<PopoverTrigger asChild>
+				<button
+					type="button"
+					disabled={disabled}
+					aria-label={t("Sampling settings")}
+					className="rounded-md p-1.5 text-muted-foreground hover:bg-surface-hover disabled:opacity-40"
+				>
+					<SlidersHorizontal className="size-3.5" />
+				</button>
+			</PopoverTrigger>
+			<PopoverContent align="end" className="w-80 max-h-[80vh] overflow-y-auto">
+				<h3 className="font-semibold">{t("Sampling settings")}</h3>
+				<p className="my-2 text-xs text-muted-foreground">
+					{t(
+						"Empty: inherit server settings. Applies to the next request. The output limit caps automatic budgets; other explicit session parameters take precedence.",
+					)}
+				</p>
+				{loading ? (
+					<p>{t("Loading...")}</p>
+				) : !supported ? (
+					<p>{t("Sampling requires an OpenAI-compatible Chat provider")}</p>
+				) : (
+					<>
+						{SAMPLING_FIELDS.map((f) => (
+							<label
+								key={f.key}
+								className="my-2 flex items-center justify-between gap-3 text-sm"
+							>
+								<span>{t(f.label)}</span>
+								<input
+									aria-label={t(f.label)}
+									type="number"
+									min={f.min}
+									max={f.max}
+									step={f.step}
+									className="w-32 rounded border bg-background px-2 py-1"
+									placeholder={t("Server default")}
+									value={draft[f.key] ?? ""}
+									disabled={saving}
+									onChange={(e) =>
+										setDraft((v) => ({ ...v, [f.key]: e.target.value }))
+									}
+								/>
+							</label>
+						))}
+						<button
+							type="button"
+							className="rounded border px-3 py-1"
+							disabled={saving}
+							onClick={() => void save()}
+						>
+							{t("Save")}
+						</button>
+					</>
+				)}
+				{error ? (
+					<p role="alert" className="mt-2 text-sm text-destructive">
+						{error}
+					</p>
+				) : null}
+			</PopoverContent>
+		</Popover>
+	);
+}

diff --git a/sdk/packages/core/src/services/providers/live-model-metadata.ts b/sdk/packages/core/src/services/providers/live-model-metadata.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a3564a1fc504121b950b21322e92a72e88e37f80
--- /dev/null
+++ b/sdk/packages/core/src/services/providers/live-model-metadata.ts
@@ -0,0 +1,34 @@
+import {
+	ensureCustomProvidersLoaded,
+	refreshProviderModelsFromSource,
+} from "./local-provider-service";
+import type { ProviderSettingsManager } from "../storage/provider-settings-manager";
+const pending = new Map<string, { at: number; task: Promise<unknown> }>();
+/** Local engines can change their allocated window without changing a model id. */
+export async function refreshLocalModelMetadata(
+	manager: ProviderSettingsManager,
+	providerId: string,
+): Promise<void> {
+	const baseUrl = manager.getProviderSettings(providerId)?.baseUrl;
+	if (!baseUrl) return;
+	try {
+		if (
+			!["127.0.0.1", "localhost", "[::1]"].includes(new URL(baseUrl).hostname)
+		)
+			return;
+	} catch {
+		return;
+	}
+	const key = providerId + "\0" + baseUrl,
+		previous = pending.get(key);
+	if (previous && Date.now() - previous.at < 60_000) {
+		await previous.task;
+		return;
+	}
+	const task = (async () => {
+		await ensureCustomProvidersLoaded(manager);
+		await refreshProviderModelsFromSource(manager, providerId);
+	})().catch(() => undefined);
+	pending.set(key, { at: Date.now(), task });
+	await task;
+}

+import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { setClineDir, resolveClineDir } from "@cline/shared/storage";
+import { expect, it } from "vitest";
+import { createBundledDefaults } from "./bundled-defaults";
+it("registers the installed rule and keyless MCP without overriding a user rule", () => {
+	const temp = mkdtempSync(join(tmpdir(), "bundled-defaults-"));
+	const root = join(temp, "defaults");
+	mkdirSync(root);
+	mkdirSync(join(root, "python"), { recursive: true });
+	writeFileSync(join(root, "python/python.exe"), "");
+	writeFileSync(
+		join(root, "defaults.json"),
+		JSON.stringify({ application: "Cline Desktop AVX1 RU" }),
+	);
+	writeFileSync(join(root, "ponytail.md"), "Default rule");
+	writeFileSync(join(root, "free-web-search.py"), "");
+	const previous = process.env.CLINE_DIR;
+	const previousRoot = resolveClineDir();
+	process.env.CLINE_DIR = join(temp, "profile");
+	setClineDir(join(temp, "profile"));
+	try {
+		const defaults = createBundledDefaults(root)!;
+		expect(defaults.mcpServers[0]?.registration.transport.type).toBe("stdio");
+		expect(defaults.mcpServers[0]?.registration.metadata).toMatchObject({
+			readOnly: true,
+		});
+		const rules: unknown[] = [];
+		defaults.extension.setup?.(
+			{ registerRule: (r: unknown) => rules.push(r) } as never,
+			{} as never,
+		);
+		expect(rules).toHaveLength(1);
+		mkdirSync(join(temp, "profile/rules"), { recursive: true });
+		writeFileSync(join(temp, "profile/rules/ponytail.md"), "User choice");
+		rules.length = 0;
+		defaults.extension.setup?.(
+			{ registerRule: (r: unknown) => rules.push(r) } as never,
+			{} as never,
+		);
+		expect(rules).toHaveLength(0);
+	} finally {
+		process.env.CLINE_DIR = previous;
+		setClineDir(previousRoot);
+		rmSync(temp, { recursive: true, force: true });
+	}
+});
diff --git a/sdk/packages/core/src/services/bundled-defaults.ts b/sdk/packages/core/src/services/bundled-defaults.ts
new file mode 100644
index 0000000000000000000000000000000000000000..662147dc9126a4b0d1c418aa0682ecd987b55062
--- /dev/null
+++ b/sdk/packages/core/src/services/bundled-defaults.ts
@@ -0,0 +1,58 @@
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import type { AgentExtension } from "@cline/shared";
+import { resolveClineDir } from "@cline/shared/storage";
+import type { AgentPluginPackageMcpServer } from "../extensions/agent-plugin";
+import { isAgentPluginDisabledGlobally } from "./global-settings";
+
+/** Optional installed resources; SDK consumers without the fork package are unchanged. */
+export function createBundledDefaults(resourceRoot?: string) {
+	const root =
+		resourceRoot ??
+		[
+			join(dirname(process.execPath), "bin", "defaults"),
+			join(dirname(process.execPath), "defaults"),
+		].find((p) => existsSync(join(p, "defaults.json")));
+	if (!root || isAgentPluginDisabledGlobally("avx1-defaults")) return undefined;
+	if (
+		JSON.parse(readFileSync(join(root, "defaults.json"), "utf8"))
+			.application !== "Cline Desktop AVX1 RU"
+	)
+		return undefined;
+	const python = join(root, "python", "python.exe");
+	const mcpServers: AgentPluginPackageMcpServer[] = [];
+	if (existsSync(python) && existsSync(join(root, "free-web-search.py")))
+		mcpServers.push({
+			pluginName: "avx1-defaults",
+			pluginRoot: root,
+			serverName: "web-search",
+			registration: {
+				name: "avx1-free-web-search",
+				transport: {
+					type: "stdio",
+					command: process.platform === "win32" ? `"${python}"` : python,
+					args: ["-I", "-B", "-X", "utf8", "free-web-search.py"],
+					cwd: root,
+				},
+				metadata: {
+					source: "agent-plugin",
+					plugin: "avx1-defaults",
+					readOnly: true,
+				},
+			},
+		});
+	const extension: AgentExtension = {
+		name: "avx1-ponytail",
+		manifest: { capabilities: ["rules"] },
+		setup(api) {
+			// A user-managed rule, including a disabled one, remains authoritative.
+			if (!existsSync(join(resolveClineDir(), "rules", "ponytail.md")))
+				api.registerRule({
+					id: "avx1-ponytail",
+					source: "bundled-ponytail",
+					content: () => readFileSync(join(root, "ponytail.md"), "utf8"),
+				});
+		},
+	};
+	return { extension, mcpServers };
+}

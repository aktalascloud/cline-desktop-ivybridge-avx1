+
+describe("session shell environment validation", () => {
+	it("copies an explicit snapshot and preserves empty values and absent keys", () => {
+		const input = { CANARY: "first", EMPTY: "", ABSENT: undefined };
+		const copy = captureShellEnvironment(input);
+		input.CANARY = "second";
+		expect(copy).toEqual({ CANARY: "first", EMPTY: "" });
+		expect(Object.isFrozen(copy)).toBe(true);
+		expect(parseShellEnvironment(undefined)).toBeUndefined();
+		expect(parseShellEnvironment({})).toEqual({});
+	});
+	it.each([
+		[null, SHELL_ENVIRONMENT_ERRORS.object],
+		[[], SHELL_ENVIRONMENT_ERRORS.object],
+		["secret-sentinel", SHELL_ENVIRONMENT_ERRORS.object],
+		[
+			Object.fromEntries(
+				Array.from({ length: 4097 }, (_, i) => [`KEY${i}`, "secret-sentinel"]),
+			),
+			SHELL_ENVIRONMENT_ERRORS.count,
+		],
+		[{ "": "secret-sentinel" }, SHELL_ENVIRONMENT_ERRORS.name],
+		[{ "BAD=NAME": "secret-sentinel" }, SHELL_ENVIRONMENT_ERRORS.name],
+		[{ "BAD\0NAME": "secret-sentinel" }, SHELL_ENVIRONMENT_ERRORS.name],
+		[{ ["N".repeat(257)]: "secret-sentinel" }, SHELL_ENVIRONMENT_ERRORS.name],
+		[{ CANARY: 42 }, SHELL_ENVIRONMENT_ERRORS.value],
+		[{ CANARY: "secret-sentinel\0" }, SHELL_ENVIRONMENT_ERRORS.value],
+		[
+			{ CANARY: "x".repeat(MAX_SHELL_ENVIRONMENT_BYTES) },
+			SHELL_ENVIRONMENT_ERRORS.bytes,
+		],
+	])("rejects invalid wire input with a distinct constant message and no contents (%#)", (value, message) => {
+		let thrown: unknown;
+		try {
+			parseShellEnvironment(value);
+		} catch (error) {
+			thrown = error;
+		}
+		expect(thrown).toBeInstanceOf(Error);
+		expect((thrown as Error).message).toBe(message);
+		expect((thrown as Error).message).not.toMatch(
+			/secret-sentinel|CANARY|KEY\d|BAD|N{10}/,
+		);
+	});
+	it("keeps each failure class message distinct", () => {
+		expect(new Set(Object.values(SHELL_ENVIRONMENT_ERRORS)).size).toBe(
+			Object.keys(SHELL_ENVIRONMENT_ERRORS).length,
+		);
+	});
+	it("handles prototype-like names as data", () => {
+		const input = JSON.parse('{"__proto__":"canary"}');
+		expect(parseShellEnvironment(input)?.__proto__).toBe("canary");
+	});
+});
diff --git a/sdk/packages/core/src/services/shell-environment.ts b/sdk/packages/core/src/services/shell-environment.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0bd21146f0a21a5b600318d4c153adb281544e4a
--- /dev/null
+++ b/sdk/packages/core/src/services/shell-environment.ts
@@ -0,0 +1,57 @@
+/** An ephemeral, owning-session shell environment, never session metadata. */
+export type ShellEnvironment = Readonly<Record<string, string>>;
+
+export const MAX_SHELL_ENVIRONMENT_BYTES = 256 * 1024;
+const MAX_SHELL_ENVIRONMENT_ENTRIES = 4096;
+
+/** Constant per failure class: never include a variable name or value. */
+export const SHELL_ENVIRONMENT_ERRORS = {
+	object: "Session shell environment must be an object.",
+	count: "Session shell environment has too many entries.",
+	name: "Session shell environment has an invalid variable name.",
+	value: "Session shell environment has an invalid variable value.",
+	bytes: "Session shell environment exceeds 256 KiB.",
+} as const;
+
+/** Validate untrusted wire input without including names or values in errors. */
+export function parseShellEnvironment(
+	value: unknown,
+): ShellEnvironment | undefined {
+	if (value === undefined) return undefined;
+	if (!value || typeof value !== "object" || Array.isArray(value)) {
+		throw new Error(SHELL_ENVIRONMENT_ERRORS.object);
+	}
+	const entries = Object.entries(value);
+	if (entries.length > MAX_SHELL_ENVIRONMENT_ENTRIES) {
+		throw new Error(SHELL_ENVIRONMENT_ERRORS.count);
+	}
+	const environment: Record<string, string> = Object.create(null);
+	let bytes = 0;
+	for (const [name, entry] of entries) {
+		if (!name || name.length > 256 || /[=\0]/.test(name)) {
+			throw new Error(SHELL_ENVIRONMENT_ERRORS.name);
+		}
+		if (typeof entry !== "string" || entry.includes("\0")) {
+			throw new Error(SHELL_ENVIRONMENT_ERRORS.value);
+		}
+		bytes += Buffer.byteLength(name) + Buffer.byteLength(entry) + 2;
+		if (bytes > MAX_SHELL_ENVIRONMENT_BYTES) {
+			throw new Error(SHELL_ENVIRONMENT_ERRORS.bytes);
+		}
+		environment[name] = entry;
+	}
+	return Object.freeze(environment);
+}
+
+/** Copy at session creation, omitting process.env's unset entries. */
+export function captureShellEnvironment(
+	environment: Readonly<Record<string, string | undefined>>,
+): ShellEnvironment {
+	const snapshot = parseShellEnvironment(
+		Object.fromEntries(
+			Object.entries(environment).filter((entry) => entry[1] !== undefined),
+		),
+	);
+	if (!snapshot) throw new Error(SHELL_ENVIRONMENT_ERRORS.object);
+	return snapshot;
+}

+const wire = vi.hoisted(() => ({ command: vi.fn() }));
+vi.mock("../client", () => ({
+	NodeHubClient: class {
+		command = wire.command;
+		subscribe = () => () => {};
+		dispose = async () => {};
+		close = async () => {};

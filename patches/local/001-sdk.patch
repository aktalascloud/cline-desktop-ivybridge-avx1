@@ -0,0 +1,42 @@
+import { createHash } from "node:crypto";
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { resolveClineDir, setClineDir } from "@cline/shared/storage";
+import { expect, it, vi } from "vitest";
+import { resolveBundledAgentPlugin } from "./bundled-agent-plugin";
+vi.mock("node:crypto", () => ({ createHash: vi.fn() }));
+it("overrides only approved official bytes, preserving custom plugins and on-disk profile", () => {
+	const temp = mkdtempSync(join(tmpdir(), "plugin-override-")),
+		previous = resolveClineDir();
+	setClineDir(temp);
+	const original = join(
+			temp,
+			"plugins/_installed/official/agents-squad-abcdef/package/index.ts",
+		),
+		root = join(temp, "defaults"),
+		replacement = join(root, "agents-squad/index.js");
+	mkdirSync(join(root, "agents-squad"), { recursive: true });
+	mkdirSync(join(original, ".."), { recursive: true });
+	writeFileSync(original, "known plugin");
+	writeFileSync(replacement, "trusted bundled plugin");
+	try {
+		vi.mocked(createHash).mockReturnValue({
+			update: () => ({
+				digest: () =>
+					"1fb3fc3d20f1a6a7f7d799068a01f155a519579cb864a53588cb6e106305f323",
+			}),
+		} as never);
+		expect(resolveBundledAgentPlugin(original, root)).toBe(replacement);
+		expect(
+			resolveBundledAgentPlugin(join(temp, "custom/index.ts"), root),
+		).toContain("custom");
+		vi.mocked(createHash).mockReturnValue({
+			update: () => ({ digest: () => "user-edited" }),
+		} as never);
+		expect(resolveBundledAgentPlugin(original, root)).toBe(original);
+	} finally {
+		setClineDir(previous);
+		rmSync(temp, { recursive: true, force: true });
+	}
+});
diff --git a/sdk/packages/core/src/services/bundled-agent-plugin.ts b/sdk/packages/core/src/services/bundled-agent-plugin.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f1afc05682021091c8a5e79eb3c27403f2d8ce7f
--- /dev/null
+++ b/sdk/packages/core/src/services/bundled-agent-plugin.ts
@@ -0,0 +1,47 @@
+import { createHash } from "node:crypto";
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join, relative, resolve } from "node:path";
+import { resolveClineDir } from "@cline/shared/storage";
+
+const REPAIRABLE = new Set([
+	"33c08929a7aa0a721f7f3372e26020f41898c8454ef3017bbce713e4aa3f2869",
+	"1fb3fc3d20f1a6a7f7d799068a01f155a519579cb864a53588cb6e106305f323",
+	"8ed471d098cf1d92e7331887f13ed743333d1749efe1aae2102d2b9abbef194a",
+]);
+
+/** Replace only known official plugin bytes; user edits and permissions remain authoritative. */
+export function resolveBundledAgentPlugin(
+	pluginPath: string,
+	resourceRoot?: string,
+): string {
+	const original = resolve(pluginPath);
+	const official = join(resolveClineDir(), "plugins", "_installed", "official");
+	const parts = relative(official, original).replaceAll("\\", "/").split("/");
+	if (
+		parts.length !== 3 ||
+		!/^agents-squad-[a-f0-9]+$/.test(parts[0]) ||
+		parts[1] !== "package" ||
+		parts[2] !== "index.ts"
+	)
+		return pluginPath;
+	const replacement = (
+		resourceRoot
+			? [resourceRoot]
+			: [
+					join(dirname(process.execPath), "bin", "defaults"),
+					join(dirname(process.execPath), "defaults"),
+				]
+	)
+		.map((root) => join(root, "agents-squad", "index.js"))
+		.find((path) => existsSync(path));
+	if (!replacement) return pluginPath;
+	try {
+		return REPAIRABLE.has(
+			createHash("sha256").update(readFileSync(original)).digest("hex"),
+		)
+			? replacement
+			: pluginPath;
+	} catch {
+		return pluginPath;
+	}
+}

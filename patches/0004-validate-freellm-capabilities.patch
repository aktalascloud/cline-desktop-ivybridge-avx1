 describe("live provider model loading", () => {
+	it("validates the shipped three-model FreeLLM catalog", async () => {
+		const catalog = await readModelsFile(
+			fileURLToPath(
+				new URL("../../../../../../fork/defaults/freellm.json", import.meta.url),

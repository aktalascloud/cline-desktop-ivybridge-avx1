+import { setPluginSandboxLauncher } from "@cline/core";
+import { claimHubDaemonProcess } from "@cline/shared";
+
+claimHubDaemonProcess();
+delete process.env.ELECTRON_RUN_AS_NODE;
+setPluginSandboxLauncher({
+	command: process.execPath,
+	argsPrefix: [],
+	env: { ELECTRON_RUN_AS_NODE: "1" },
+});
+await import("@cline/core/hub/daemon-entry");
diff --git a/apps/examples/desktop-app/legacy/installer.nsi b/apps/examples/desktop-app/legacy/installer.nsi
new file mode 100644
index 0000000000000000000000000000000000000000..f2bf58eb6b821abb82a3e2edd8ceb52bf5654097
--- /dev/null
+++ b/apps/examples/desktop-app/legacy/installer.nsi
@@ -0,0 +1,99 @@
+Unicode true
+RequestExecutionLevel user
+SetCompressor /SOLID lzma
+SetCompressorDictSize 16
+
+!include MUI2.nsh
+!include LogicLib.nsh
+!include WinVer.nsh
+!include x64.nsh
+!include "Win\RestartManager.nsh"
+
+!define PRODUCT "Cline Desktop Legacy"
+!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\ClineDesktopLegacy"
+Name "${PRODUCT}"
+OutFile "${CLINE_INSTALLER}"
+InstallDir "$LOCALAPPDATA\Programs\Cline Desktop Legacy"
+InstallDirRegKey HKCU "${UNINSTALL_KEY}" InstallLocation
+VIProductVersion "0.0.51.0"
+VIAddVersionKey "FileDescription" "Cline Desktop Legacy Setup"
+VIAddVersionKey "ProductName" "${PRODUCT}"
+VIAddVersionKey "FileVersion" "0.0.51"
+VIAddVersionKey "LegalCopyright" "Cline contributors"
+!define MUI_ICON "${CLINE_STAGE}\resources\app\icon.ico"
+!define MUI_UNICON "${CLINE_STAGE}\resources\app\icon.ico"
+
+!insertmacro MUI_PAGE_INSTFILES
+!insertmacro MUI_UNPAGE_CONFIRM
+!insertmacro MUI_UNPAGE_INSTFILES
+!insertmacro MUI_LANGUAGE "English"
+!insertmacro MUI_LANGUAGE "Russian"
+
+Function .onInit
+  ${IfNot} ${RunningX64}
+  ${OrIfNot} ${AtLeastWin7}
+    MessageBox MB_OK|MB_ICONSTOP "Cline Desktop Legacy requires 64-bit Windows 7 SP1 or later." /SD IDOK
+    SetErrorLevel 2
+    Abort
+  ${EndIf}
+  ${If} ${IsWin7}
+  ${AndIfNot} ${AtLeastServicePack} 1
+    MessageBox MB_OK|MB_ICONSTOP "Install Service Pack 1 for Windows 7 before running Cline Desktop Legacy." /SD IDOK
+    SetErrorLevel 2
+    Abort
+  ${EndIf}
+FunctionEnd
+
+!macro ReleaseExecutable PREFIX
+Function ${PREFIX}ReleaseExecutable
+  IfFileExists "$INSTDIR\ClineLegacy.exe" 0 done
+  System::Call 'rstrtmgr::RmStartSession(*i .r1, i 0, w .r2) i .r0'
+  ${If} $0 != 0
+    Goto failed
+  ${EndIf}
+  !insertmacro RestartManager_RegisterFile $1 "$INSTDIR\ClineLegacy.exe"
+  ${If} $0 == 0
+    StrCpy $3 0
+    System::Call 'rstrtmgr::RmGetList(i r1, *i .r2, *i r3, p 0, *i .r4) i .r0'
+    ${If} $0 == 234
+      System::Call 'rstrtmgr::RmShutdown(i r1, i ${RmForceShutdown}, p 0) i .r0'
+    ${EndIf}
+  ${EndIf}
+  System::Call 'rstrtmgr::RmEndSession(i r1)'
+  ${If} $0 == 0
+    Goto done
+  ${EndIf}
+  failed:
+    MessageBox MB_OK|MB_ICONSTOP "Close Cline Desktop Legacy and its background processes, then retry." /SD IDOK
+    SetErrorLevel 2
+    Abort
+  done:
+FunctionEnd
+!macroend
+
+!insertmacro ReleaseExecutable ""
+!insertmacro ReleaseExecutable "un."
+
+Section "Install"
+  Call ReleaseExecutable
+  SetOutPath "$INSTDIR"
+  File /r "${CLINE_STAGE}\*"
+  WriteUninstaller "$INSTDIR\Uninstall.exe"
+  WriteRegStr HKCU "${UNINSTALL_KEY}" DisplayName "${PRODUCT}"
+  WriteRegStr HKCU "${UNINSTALL_KEY}" DisplayVersion "0.0.51"
+  WriteRegStr HKCU "${UNINSTALL_KEY}" InstallLocation "$INSTDIR"
+  WriteRegStr HKCU "${UNINSTALL_KEY}" DisplayIcon "$INSTDIR\ClineLegacy.exe"
+  WriteRegStr HKCU "${UNINSTALL_KEY}" UninstallString '$\"$INSTDIR\Uninstall.exe$\"'
+  WriteRegDWORD HKCU "${UNINSTALL_KEY}" NoModify 1
+  WriteRegDWORD HKCU "${UNINSTALL_KEY}" NoRepair 1
+  CreateShortCut "$SMPROGRAMS\Cline Desktop Legacy.lnk" "$INSTDIR\ClineLegacy.exe" "" "$INSTDIR\resources\app\icon.ico"
+SectionEnd
+
+Section "Uninstall"
+  Call un.ReleaseExecutable
+  !include "${CLINE_UNINSTALL_FILES}"
+  Delete "$INSTDIR\Uninstall.exe"
+  Delete "$SMPROGRAMS\Cline Desktop Legacy.lnk"
+  DeleteRegKey HKCU "${UNINSTALL_KEY}"
+  RMDir "$INSTDIR"
+SectionEnd
diff --git a/apps/examples/desktop-app/legacy/main.cjs b/apps/examples/desktop-app/legacy/main.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..28b594ac91197812f8cfbbf78d0f046163012be8
--- /dev/null
+++ b/apps/examples/desktop-app/legacy/main.cjs
@@ -0,0 +1,315 @@
+const {
+	app,
+	BrowserWindow,
+	dialog,
+	ipcMain,
+	net,
+	protocol,
+	shell,
+} = require("electron");
+const { fork } = require("node:child_process");
+const { existsSync, mkdirSync, writeFileSync } = require("node:fs");
+const { createServer } = require("node:net");
+const { dirname, join, resolve, sep } = require("node:path");
+const { pathToFileURL } = require("node:url");
+
+const origin = "cline://desktop";
+const webRoot = join(__dirname, "web");
+const runtimeRoot = join(__dirname, "runtime");
+const stateRoot = join(app.getPath("appData"), "Cline Desktop Legacy");
+const smokeFlag = process.argv.find((arg) => arg.startsWith("--smoke-test="));
+const smokeOutput = smokeFlag?.slice("--smoke-test=".length);
+app.setPath(
+	"userData",
+	smokeOutput ? join(dirname(resolve(smokeOutput)), "profile") : stateRoot,
+);
+app.setAppUserModelId("bot.cline.app.legacy");
+app.commandLine.appendSwitch("disk-cache-size", "33554432");
+protocol.registerSchemesAsPrivileged([
+	{
+		scheme: "cline",
+		privileges: {
+			standard: true,
+			secure: true,
+			supportFetchAPI: true,
+			corsEnabled: true,
+			codeCache: true,
+		},
+	},
+]);
+
+let window;
+let backend;
+let quitting = false;
+
+function isAppUrl(rawUrl) {
+	try {
+		const url = new URL(rawUrl);
+		return (
+			url.protocol === "cline:" &&
+			url.host === "desktop" &&
+			!url.username &&
+			!url.password
+		);
+	} catch {
+		return false;
+	}
+}
+
+function openExternal(rawUrl) {
+	const url = new URL(rawUrl);
+	if (!["https:", "http:", "mailto:"].includes(url.protocol)) {
+		throw new Error("Unsupported external URL");
+	}
+	return shell.openExternal(url.href);
+}
+
+function serveWeb(request) {
+	if (!isAppUrl(request.url) || request.method !== "GET") {
+		return new Response("Forbidden", { status: 403 });
+	}
+	try {
+		const url = new URL(request.url);
+		const path = decodeURIComponent(url.pathname);
+		if (path.includes("\\") || path.includes("\0") || path.includes(":")) {
+			return new Response("Forbidden", { status: 403 });
+		}
+		const candidate = resolve(webRoot, "." + path);
+		if (candidate !== webRoot && !candidate.startsWith(webRoot + sep)) {
+			return new Response("Forbidden", { status: 403 });
+		}
+		const candidates = path.endsWith("/")
+			? [join(candidate, "index.html"), candidate + ".html"]
+			: [candidate, candidate + ".html", join(candidate, "index.html")];
+		return (async () => {
+			for (const file of candidates) {
+				if (!existsSync(file)) continue;
+				try {
+					return await net.fetch(pathToFileURL(file).href);
+				} catch {
+					// Try the exported .html entry when the matching path is a directory.
+				}
+			}
+			return new Response("Not found", { status: 404 });
+		})();
+	} catch {
+		return new Response("Invalid URL", { status: 400 });
+	}
+}
+
+function freeLoopbackPort() {
+	return new Promise((resolvePort, reject) => {
+		const server = createServer();
+		server.once("error", reject);
+		server.listen(0, "127.0.0.1", () => {
+			const { port } = server.address();
+			server.close((error) => (error ? reject(error) : resolvePort(port)));
+		});
+	});
+}
+
+async function startBackend() {
+	const profile = app.getPath("userData");
+	const hubPort = smokeOutput
+		? await freeLoopbackPort()
+		: process.env.CLINE_LEGACY_HUB_PORT || "25473";
+	const sidecar = fork(join(runtimeRoot, "sidecar", "index.mjs"), [], {
+		execPath: process.execPath,
+		cwd: runtimeRoot,
+		execArgv: [],
+		windowsHide: true,
+		stdio: ["ignore", "ignore", "pipe", "ipc"],
+		env: {
+			...process.env,
+			ELECTRON_RUN_AS_NODE: "1",
+			CLINE_DIR: join(profile, "cline"),
+			CLINE_DATA_DIR: join(profile, "cline", "data"),
+			CLINE_HUB_DISCOVERY_PATH: join(profile, "hub-discovery.json"),
+			CLINE_HUB_HOST: "127.0.0.1",
+			CLINE_HUB_PORT: String(hubPort),
+			CLINE_HUB_PATHNAME: "/hub",
+			CLINE_SIDECAR_HOST: "127.0.0.1",
+			CLINE_LEGACY_APP_ORIGIN: origin,
+			CLINE_LEGACY_RUNTIME_ROOT: join(runtimeRoot, "legacy"),
+			CLINE_PLUGIN_RUNTIME_DIR: join(runtimeRoot, "plugin-runtime"),
+			CLINE_SIDECAR_TRUSTED_ORIGINS: origin,
+			CLINE_DESKTOP_WORKSPACE_ROOT: app.getPath("documents"),
+			CLINE_NO_AUTO_UPDATE: "1",
+			UV_THREADPOOL_SIZE: "2",
+		},
+	});
+	backend = sidecar;
+	let stderr = "";
+	sidecar.stderr.on("data", (data) => {
+		stderr = (stderr + data).slice(-4096);
+	});
+	return new Promise((resolveReady, reject) => {
+		const timer = setTimeout(() => {
+			sidecar.kill();
+			reject(new Error("The Cline backend did not start in 90 seconds."));
+		}, 90_000);
+		sidecar.once("error", (error) => {
+			clearTimeout(timer);
+			reject(error);
+		});
+		sidecar.once("exit", (code) => {
+			clearTimeout(timer);
+			const error = new Error(
+				`Cline backend exited (${code}). ${stderr.trim()}`,
+			);
+			reject(error);
+			if (window && !quitting && !smokeOutput) {
+				dialog.showErrorBox("Cline Desktop Legacy", error.message);
+				app.quit();
+			}
+		});
+		sidecar.on("message", (message) => {
+			if (message?.type !== "ready" || typeof message.wsEndpoint !== "string")
+				return;
+			clearTimeout(timer);
+			resolveReady(message.wsEndpoint);
+		});
+	});
+}
+
+ipcMain.handle("cline:native", async (event, command, args) => {
+	if (
+		event.sender !== window?.webContents ||
+		!event.senderFrame ||
+		event.senderFrame.parent ||
+		!isAppUrl(event.senderFrame.url)
+	) {
+		throw new Error("Invalid Cline window");
+	}
+	switch (command) {
+		case "pick_workspace_directory": {
+			const { filePaths } = await dialog.showOpenDialog(window, {
+				defaultPath:
+					typeof args?.initialPath === "string" ? args.initialPath : undefined,
+				properties: ["openDirectory"],
+			});
+			return filePaths[0] ?? null;
+		}
+		case "open_third_party_notices":
+			return shell.openPath(join(__dirname, "THIRD_PARTY_NOTICES.txt"));
+		case "open_external_url":
+			return openExternal(args?.url);
+		case "relaunch_app":
+			app.relaunch();
+			app.quit();
+			return;
+		case "quit_app":
+			app.quit();
+			return;
+		default:
+			throw new Error("Unsupported native command");
+	}
+});
+
+async function runSmokeTest() {
+	return window.webContents.executeJavaScript(`new Promise((resolve, reject) => {
+		const socket = new WebSocket(window.__SIDECAR_WS_ENDPOINT__);
+		const timer = setTimeout(() => { socket.close(); reject(Error("Hub smoke test timed out")); }, 60000);
+		socket.onerror = () => { clearTimeout(timer); reject(Error("Could not connect to backend")); };
+		socket.onmessage = ({data}) => {
+			const message = JSON.parse(data);
+			if (message.event?.name === "hub_status") {
+				if (message.event.payload.state === "failed") {
+					clearTimeout(timer);
+					socket.close();
+					reject(Error(message.event.payload.error ?? "Hub startup failed"));
+				}
+				if (message.event.payload.state === "ready") {
+					socket.send(JSON.stringify({ type: "command", id: "smoke", command: "get_process_context" }));
+				}
+			}
+			if (message.id === "smoke") {
+				clearTimeout(timer);
+				socket.close();
+				if (message.ok) resolve({ title: document.title, sidecar: true, hub: true, renderer: Boolean(document.querySelector("main,button")) });
+				else reject(Error(message.error));
+			}
+		};
+	})`);
+}
+
+async function start() {
+	protocol.handle("cline", serveWeb);
+	const endpoint = await startBackend();
+	window = new BrowserWindow({
+		width: 1080,
+		height: 700,
+		minWidth: 640,
+		minHeight: 440,
+		show: !smokeOutput,
+		title: "Cline Desktop Legacy",
+		autoHideMenuBar: true,
+		icon: join(__dirname, "icon.ico"),
+		webPreferences: {
+			preload: join(__dirname, "preload.cjs"),
+			sandbox: true,
+			contextIsolation: true,
+			nodeIntegration: false,
+			additionalArguments: [`--cline-sidecar=${endpoint}`],
+		},
+	});
+	window.webContents.on("will-navigate", (event, url) => {
+		if (!isAppUrl(url)) event.preventDefault();
+	});
+	window.webContents.on("will-attach-webview", (event) =>
+		event.preventDefault(),
+	);
+	window.webContents.setWindowOpenHandler(({ url }) => {
+		if (!isAppUrl(url)) void openExternal(url).catch(() => {});
+		return { action: "deny" };
+	});
+	await window.loadURL(origin + "/");
+	if (smokeOutput) {
+		const result = await runSmokeTest();
+		writeFileSync(
+			smokeOutput,
+			JSON.stringify({ ...result, versions: process.versions }, null, 2),
+		);
+		app.quit();
+	}
+}
+
+if (!app.requestSingleInstanceLock()) {
+	app.quit();
+} else {
+	mkdirSync(app.getPath("userData"), { recursive: true });
+	app.on("second-instance", () => {
+		if (!window) return;
+		if (window.isMinimized()) window.restore();
+		window.focus();
+	});
+	app.on("before-quit", (event) => {
+		if (quitting || !backend?.connected) return;
+		event.preventDefault();
+		quitting = true;
+		const grace = setTimeout(() => {
+			backend.kill();
+			app.quit();
+		}, 6_000);
+		backend.once("exit", () => {
+			clearTimeout(grace);
+			app.quit();
+		});
+		backend.disconnect();
+	});
+	app.on("window-all-closed", () => app.quit());
+	app
+		.whenReady()
+		.then(start)
+		.catch((error) => {
+			if (smokeOutput) {
+				writeFileSync(
+					smokeOutput,
+					JSON.stringify({ error: error.message }, null, 2),
+				);
+			} else {
+				dialog.showErrorBox("Cline Desktop Legacy", error.message);
+			}
+			app.quit();
+		});
+}

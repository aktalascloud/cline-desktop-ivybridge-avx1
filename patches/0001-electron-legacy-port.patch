diff --git a/apps/examples/desktop-app/legacy/package.mts b/apps/examples/desktop-app/legacy/package.mts
new file mode 100644
index 0000000000000000000000000000000000000000..56c9b3b1c16096a93766c6da4e95b832312fa14b
--- /dev/null
+++ b/apps/examples/desktop-app/legacy/package.mts
@@ -0,0 +1,143 @@
+import {
+	cpSync,
+	existsSync,
+	mkdirSync,
+	mkdtempSync,
+	readdirSync,
+	readFileSync,
+	renameSync,
+	rmSync,
+	writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { basename, join, relative, resolve } from "node:path";
+import { generateNotices } from "../../../../scripts/third-party-notices/index";
+import {
+	inputListPath,
+	recordWebviewInputs,
+} from "../scripts/third-party-notices";
+
+const legacy = import.meta.dir;
+const desktop = resolve(legacy, "..");
+const root = resolve(desktop, "../../..");
+const [electronDir, makensisExe, outputDir] = process.argv
+	.slice(2)
